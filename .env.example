# --- Database ---------------------------------------------------------------
# Neon pooled connection used by the application at runtime.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Neon direct connection used only by Prisma migrations.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Throwaway database Prisma uses to diff migrations against the schema.
# Required by `npm run db:validate`; unset locally means that script is skipped.
SHADOW_DATABASE_URL=""

# --- Auth ---------------------------------------------------------------------
# Signs session tokens and cookies. Generate with `openssl rand -base64 32`.
# Better Auth refuses to boot with a default secret outside development.
BETTER_AUTH_SECRET=""

# Canonical origin used for auth callbacks and redirects. The app falls back
# to http://localhost:3000 in development and VERCEL_URL on Vercel; set this
# explicitly for every production deployment outside Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# Auth (Phase 1b) is fully built but not enforced until this is "true" — see
# src/lib/auth/flag.ts. Off, every request uses one shared default workspace,
# same as before Better Auth existed. The plan is to flip this on once
# billing (Phase 8) is integrated.
AUTH_ENABLED="false"

# --- AI provider ------------------------------------------------------------
# Optional in this milestone. GLM calls fail closed when this is absent.
ZAI_API_KEY=""
ZAI_MODEL="glm-5.2"

# Used by src/lib/embeddings/provider.ts (Phase 5) — shares ZAI_API_KEY above.
ZAI_EMBEDDING_MODEL="embedding-3"

# --- Durable jobs -----------------------------------------------------------
# Required on deployed Inngest environments; the local dev server can omit them.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- SERP provider (Phase 3) --------------------------------------------------
# DataForSEO uses HTTP basic auth (login:password), not a bearer token.
# Optional in this milestone: HUNT calls fail closed when absent, same as
# GLM without ZAI_API_KEY.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# --- Google Search Console (Phase 3) ------------------------------------------
# From a Google Cloud OAuth 2.0 Client ID (Web application type). The
# Search Console API must be enabled on that project, and
# BETTER_AUTH_URL + "/api/integrations/google-search-console/callback"
# registered as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Secret storage (Phase 3) -------------------------------------------------
# Encrypts stored OAuth refresh tokens (src/lib/crypto/envelope.ts). Generate
# with `openssl rand -base64 32`. A KMS-backed key provider replaces this in
# a later phase without changing any caller.
INTEGRATION_ENCRYPTION_KEY_V1=""

# --- Crawl performance and rendering (Phase 4) --------------------------------
# Chrome UX Report — real-user field LCP/INP/CLS. Optional: performance
# observations are simply skipped when absent.
CRUX_API_KEY=""

# Browserless (or a compatible self-hosted instance) for pages
# src/lib/crawl/policy.ts's needsBrowserRender() flags as client-rendered.
# Optional: the crawler falls back to the static HTML it already has when
# absent, rather than failing the page.
BROWSERLESS_API_KEY=""
BROWSERLESS_ENDPOINT="https://chrome.browserless.io"

# --- Test-only ---------------------------------------------------------------
# `npm run test:integration` is skipped entirely unless this is set. Point it at
# a disposable database: the suite deletes every row whose domain ends in .test.
TEST_DATABASE_URL=""

# Set to "true" to bypass the live GLM call in onboarding and return a
# deterministic fixture profile. Playwright sets this for its own web server.
E2E_DISCOVERY_FIXTURE=""

# Overrides Next's build directory so Playwright can build without clobbering
# the .next used by `npm run dev`. Playwright sets this to .next-e2e.
NEXT_DIST_DIR=""
