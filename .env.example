# ─────────────────────────────────────────────────────────────
# Voquarn GEO Platform — environment variables
# Copy to `.env.local` and fill in real values. Never commit .env.local
# ─────────────────────────────────────────────────────────────

# Database — Neon Postgres (Vercel-native serverless)
# Use the pooled connection string for the app runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection — used by Prisma for migrations.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── AI engines (Monitoring module) ──
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# ── Search / source mapping (Execution module) ──
SERPER_API_KEY=""

# ── Authentication (Clerk) ──
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ── Billing (Paddle — merchant-of-record) ──
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# "sandbox" or "production"
NEXT_PUBLIC_PADDLE_ENV="sandbox"
# Paddle price IDs per tier (set after creating products in Paddle dashboard)
PADDLE_PRICE_STARTER=""
PADDLE_PRICE_PRO=""
PADDLE_PRICE_AGENCY=""

# ── Email notifications (Phase 3.3 — Resend) ──
RESEND_API_KEY=""

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI model tier flag (cost optimization) ──
# "cheap" uses gpt-4o-mini / gemini-flash / claude-haiku for non-critical calls.
# "full" uses the flagship models everywhere.
AI_MODEL_TIER="full"
