# --- Database ---------------------------------------------------------------
# Neon pooled connection used by the application at runtime.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Neon direct connection used only by Prisma migrations.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Throwaway database Prisma uses to diff migrations against the schema.
# Required by `npm run db:validate`; unset locally means that script is skipped.
SHADOW_DATABASE_URL=""

# --- Auth ---------------------------------------------------------------------
# Signs session tokens and cookies. Generate with `openssl rand -base64 32`.
# Better Auth refuses to boot with a default secret outside development.
BETTER_AUTH_SECRET=""

# Canonical origin used for auth callbacks and redirects. The app falls back
# to http://localhost:3000 in development and VERCEL_URL on Vercel; set this
# explicitly for every production deployment outside Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# Auth (Phase 1b) is fully built but not enforced until this is "true" — see
# src/lib/auth/flag.ts. Off, every request uses one shared default workspace,
# same as before Better Auth existed. The plan is to flip this on once
# billing (Phase 8) is integrated.
AUTH_ENABLED="false"

# --- AI provider ------------------------------------------------------------
# Optional in this milestone. GLM calls fail closed when this is absent.
ZAI_API_KEY=""
ZAI_MODEL="glm-5.2"

# --- Durable jobs -----------------------------------------------------------
# Required on deployed Inngest environments; the local dev server can omit them.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Test-only ---------------------------------------------------------------
# `npm run test:integration` is skipped entirely unless this is set. Point it at
# a disposable database: the suite deletes every row whose domain ends in .test.
TEST_DATABASE_URL=""

# Set to "true" to bypass the live GLM call in onboarding and return a
# deterministic fixture profile. Playwright sets this for its own web server.
E2E_DISCOVERY_FIXTURE=""

# Overrides Next's build directory so Playwright can build without clobbering
# the .next used by `npm run dev`. Playwright sets this to .next-e2e.
NEXT_DIST_DIR=""
