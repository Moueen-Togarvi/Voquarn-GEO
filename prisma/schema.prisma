// Voquarn GEO Platform — Prisma schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (for Migrate) and the
  // runtime client uses a driver adapter (see src/lib/db.ts). No `url` here.
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ScanStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum Engine {
  OPENAI
  CLAUDE
  GEMINI
  PERPLEXITY
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum Tier {
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum PromptSource {
  GENERATED // created by the prompt generator when a brand is added
  AI_SUGGESTED // proposed later as an AI suggestion, accepted by the user
  USER // added manually by the user
}

enum ScanFrequency {
  OFF
  WEEKLY
  DAILY
}

enum AlertType {
  VISIBILITY_DROP
  SCAN_COMPLETE
  SCAN_FAILED
}

enum FameTaskKind {
  PUBLISH_CONTENT // publish a generated article/FAQ/snippet to the brand's site
  ADD_SCHEMA // add JSON-LD schema to the site
  UPDATE_LLMS_TXT // publish/refresh llms.txt
  SUBMIT_INDEXNOW // ping IndexNow so Bing/ChatGPT re-crawl
  GET_MENTION // arrange an off-site mention (human-driven)
}

enum FameTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IntegrationProvider {
  WORDPRESS
  WEBFLOW
  GENERIC_WEBHOOK
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

/// An application user, mirrored from Clerk. `clerkId` is the source of truth
/// for identity; we keep a local row so brands can hang off a stable FK.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  createdAt DateTime @default(now())

  brands       Brand[]
  subscription Subscription?

  @@index([clerkId])
}

/// The user's billing subscription (Paddle). Absent = free STARTER defaults.
model Subscription {
  id               String             @id @default(cuid())
  tier             Tier               @default(STARTER)
  status           SubscriptionStatus @default(ACTIVE)
  paddleCustomerId String?
  paddleSubId      String?            @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A brand the user is monitoring across AI engines.
model Brand {
  id              String        @id @default(cuid())
  name            String
  domain          String
  industry        String
  description     String?
  scanFrequency   ScanFrequency @default(OFF)
  lastScheduledAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  competitors       Competitor[]
  prompts           Prompt[]
  scanRuns          ScanRun[]
  visibilityScores  VisibilityScore[]
  gaps              Gap[]
  promptSuggestions PromptSuggestion[]
  alerts            Alert[]
  fameTasks         FameTask[]
  integrations      Integration[]

  @@index([userId])
}

/// A competitor brand we watch for in AI answers alongside the tracked brand.
model Competitor {
  id     String  @id @default(cuid())
  name   String
  domain String?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// A realistic buyer-intent query we run through the engines for a brand.
model Prompt {
  id        String       @id @default(cuid())
  text      String
  category  String
  /// Rough estimated monthly search volume (Claude-bucketed; null if unknown).
  volume    Int?
  tags      String[]
  source    PromptSource @default(GENERATED)
  createdAt DateTime     @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  results Result[]

  @@index([brandId])
}

/// An AI-suggested prompt awaiting the user's accept/dismiss decision. When
/// accepted it becomes a Prompt (source = AI_SUGGESTED).
model PromptSuggestion {
  id        String   @id @default(cuid())
  text      String
  category  String
  volume    Int?
  reason    String
  accepted  Boolean  @default(false)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// A notification for a brand (visibility drop, scan complete/failed).
model Alert {
  id        String    @id @default(cuid())
  type      AlertType
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, read])
}

/// One execution of all prompts across all engines for a brand.
model ScanRun {
  id          String     @id @default(cuid())
  status      ScanStatus @default(PENDING)
  startedAt   DateTime   @default(now())
  completedAt DateTime?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  results          Result[]
  visibilityScores VisibilityScore[]

  @@index([brandId])
}

/// The response from a single engine to a single prompt, plus parsed signals.
model Result {
  id             String     @id @default(cuid())
  engine         Engine
  responseText   String
  brandMentioned Boolean    @default(false)
  position       Int?
  /// Ordinal rank of the brand among all brands named in the answer
  /// (1 = named first). Null when the brand is not mentioned.
  rank           Int?
  sentiment      Sentiment?
  citedSources   String[]
  createdAt      DateTime   @default(now())

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  scanRunId String
  scanRun   ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId])
  @@index([promptId])
  @@index([scanRunId, engine])
}

/// Aggregated per-engine visibility metrics for one scan run.
model VisibilityScore {
  id           String @id @default(cuid())
  engine       Engine
  score        Float // % of prompts where the brand was mentioned (0-100)
  shareOfVoice Float // brand mentions / (brand + competitor mentions)
  citationRate Float // % of prompts where the brand's domain was cited

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  scanRunId String
  scanRun   ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@unique([scanRunId, engine])
  @@index([brandId, scanRunId])
}

/// A prompt where the brand is absent but competitors win — an actionable
/// optimization opportunity surfaced by gap analysis. Persisted so the Action
/// Center can track completion.
model Gap {
  id                 String   @id @default(cuid())
  promptText         String
  category           String
  competitorsWinning String[]
  citedSources       String[]
  severity           Severity
  recommendedAction  String
  addressed          Boolean  @default(false)
  createdAt          DateTime @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// One step in a brand's "Fame Plan" — the ordered checklist that actually
/// improves AI visibility (publish content, add schema, submit IndexNow, etc.).
model FameTask {
  id           String         @id @default(cuid())
  kind         FameTaskKind
  title        String
  detail       String
  status       FameTaskStatus @default(TODO)
  /// Arbitrary task payload (e.g. generated content, target competitor, URLs).
  payload      Json?
  /// The published URL once a PUBLISH_CONTENT task completes.
  publishedUrl String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

/// A connected publishing destination (WordPress site, Webflow CMS, or a
/// generic webhook) the platform can publish generated content to.
model Integration {
  id          String              @id @default(cuid())
  provider    IntegrationProvider
  siteUrl     String?
  /// Provider credentials (API token / app password / webhook secret).
  /// Stored as JSON; treat as sensitive.
  credentials Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}
