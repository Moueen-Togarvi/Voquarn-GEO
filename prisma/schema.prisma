generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PromptType {
  CATEGORY
  COMPARISON
  USE_CASE
  BRAND_SPECIFIC
}

enum BatchStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  FAILED
  CANCELLED
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum PromptSource {
  AI_GENERATED
  USER_ADDED
}

enum BrandStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CompetitorSource {
  AI_DISCOVERED
  SERP_DISCOVERED
  USER_ADDED
}

enum CompetitorStatus {
  CANDIDATE
  ACCEPTED
  IGNORED
  PINNED
}

// One entry per phase deliverable in docs/events.md. Extending this list is
// cheap (ALTER TYPE ... ADD VALUE); reusing BRAND_DISCOVERY for both onboarding
// and re-analysis is deliberate, not an omission.
enum OperationKind {
  BRAND_DISCOVERY
  PROMPT_GENERATION
  BENCHMARK_BATCH
  SERP_HUNT
  THREAT_SCORE
  CRAWL
  OPPORTUNITY_DETECT
  CONTENT_BRIEF
  CONTENT_DRAFT
  PUBLICATION
  GSC_IMPORT
  WEEKLY_REPORT
}

// PARTIAL is a real outcome, not a failure — see docs/events.md.
enum OperationStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

// Mirrors the provider contracts in docs/adr/0003-provider-abstraction.md.
enum ProviderCapability {
  GENERATION
  BENCHMARK
  SERP
  KEYWORDS
  BACKLINKS
  CRAWL
  ANALYTICS
  PUBLISHING
  NOTIFICATION
  EMBEDDING
}

enum StorageDriver {
  DB
  S3
}

enum RetentionClass {
  STANDARD
  EXTENDED
  LEGAL_HOLD
}

enum MarketDevice {
  DESKTOP
  MOBILE
}

enum SiteVerificationMethod {
  DNS_TXT
  HTML_FILE
  GSC_OAUTH
}

enum KeywordIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
}

enum ProjectKeywordPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectKeywordStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum GoalType {
  INCREASE_AI_VISIBILITY
  INCREASE_ORGANIC_TRAFFIC
  IMPROVE_SHARE_OF_VOICE
  OUTRANK_COMPETITOR
  OTHER
}

enum SerpResultType {
  ORGANIC
  AI_OVERVIEW
  PAA
  VIDEO
  LOCAL
}

// GOOGLE_SEARCH_CONSOLE today; future CMS connectors (Phase 7+) extend this
// list rather than introducing a second connection model.
enum IntegrationProvider {
  GOOGLE_SEARCH_CONSOLE
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  REVOKED
  ERROR
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum CrawlRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL_FAILURE
  FAILED
}

enum RenderMode {
  STATIC
  BROWSER
}

enum PerformanceSource {
  FIELD
  LAB
}

// See src/lib/opportunity/detectors/*.ts — one file per kind, each a pure
// function over already-resolved evidence (own vs. competitor page coverage,
// SERP standing, benchmark citation share). CITATION_GAP is brand-wide (per
// competitor), not topic-scoped — see the model comment on Opportunity.
enum OpportunityKind {
  MISSING_COVERAGE
  WEAK_COVERAGE
  STALE
  INTENT_MISMATCH
  COMPARISON
  CITATION_GAP
}

// NEW is the only state a detector run ever writes. Every other transition
// is a human decision, recorded as an OpportunityDecision row that also
// updates this field — see the model comment there.
enum OpportunityStatus {
  NEW
  ACCEPTED
  DEFERRED
  DISMISSED
  IN_PROGRESS
  COMPLETED
}

enum OpportunityEvidenceKind {
  OWN_PAGE
  COMPETITOR_PAGE
  SERP_OBSERVATION
  BENCHMARK_MENTION
  KEYWORD
}

// The full state machine from the implementation plan's Phase 6 migration.
// PUBLISHING/PUBLISHED/MONITORING are reserved — nothing in Phase 6 drives a
// ContentItem past APPROVED; Phase 7's publish workflow is what advances
// them, the same "reserved slot, never fabricated" treatment as
// PerformanceObservation.source = LAB in Phase 4.
enum ContentState {
  PLANNED
  RESEARCHING
  BRIEF_READY
  DRAFTING
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  MONITORING
  CANCELLED
  FAILED
  ARCHIVED
  ROLLED_BACK
}

// "Every factual claim has a source, is explicitly marked opinion/first-party
// input, or is removed" — OPINION/FIRST_PARTY claims are exempt from the
// unsourced-claim blocker in src/lib/content/blockers.ts; FACTUAL is not.
enum ClaimKind {
  FACTUAL
  OPINION
  FIRST_PARTY
}

enum ClaimStatus {
  UNRESOLVED
  RESOLVED
  RISKY
}

// Claims touching these categories are flagged for enhanced human review
// regardless of sourcing — see src/lib/content/blockers.ts. Not a
// determination of accuracy, just "this needs a careful human read."
enum RiskCategory {
  MEDICAL
  LEGAL
  FINANCIAL
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

// Values are written by our own code only (Member.role, Invitation.role via
// the organization plugin's `roles`/`creatorRole` options in
// src/lib/auth/server.ts) — Better Auth never writes a role value we didn't
// configure, unlike Invitation.status below, so a strict enum is safe here.
enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// Better Auth's organization plugin maps onto this table (schema.organization
// .modelName = "workspace" in src/lib/auth/server.ts) rather than creating a
// separate `organization` table — see docs/adr/0002-auth-better-auth.md.
// `logo` and `metadata` are required by that mapping; `metadata` stores a
// JSON string, matching the plugin's own dual object/string input handling.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands Brand[]

  // Direct, workspace-scoped access to every tenant-owned table. Populated
  // alongside the Brand-scoped relations above so a service can filter by
  // workspaceId without a join through Brand — see src/lib/db/scoped.ts.
  competitors         Competitor[]
  prompts             Prompt[]
  analysisBatches     AnalysisBatch[]
  promptRuns          PromptRun[]
  runAnalyses         RunAnalysis[]
  benchmarkAggregates BenchmarkAggregate[]
  sources             Source[]

  operations    Operation[]
  providerCalls ProviderCall[]
  rawSnapshots  RawSnapshot[]
  usageEvents   UsageEvent[]
  auditEvents   AuditEvent[]
  featureFlags  FeatureFlag[]
  entitlement   Entitlement?

  members     Member[]
  invitations Invitation[]

  markets         Market[]
  sites           Site[]
  topics          Topic[]
  keywords        Keyword[]
  projectKeywords ProjectKeyword[]
  goals           Goal[]
  voiceProfiles   BrandVoiceProfile[]

  serpSnapshots          SerpSnapshot[]
  serpResults            SerpResult[]
  competitorObservations CompetitorObservation[]
  threatScores           ThreatScore[]
  integrationConnections IntegrationConnection[]
  encryptedSecrets       EncryptedSecret[]
  webhookDeliveries      WebhookDelivery[]
  searchPerformanceRows  SearchPerformanceRow[]

  crawlRuns            CrawlRun[]
  pageSnapshots        PageSnapshot[]
  pageObservations     PageObservation[]
  schemaObservations   SchemaObservation[]
  performanceObservations PerformanceObservation[]

  opportunities         Opportunity[]
  opportunityEvidence   OpportunityEvidence[]
  opportunityDecisions  OpportunityDecision[]
  conquestPlans         ConquestPlan[]
  planItems             PlanItem[]

  contentItems    ContentItem[]
  researchPackets ResearchPacket[]
  contentVersions ContentVersion[]
  claims          Claim[]
  evidenceLinks   EvidenceLink[]
  approvals       Approval[]
  qualityScores   QualityScore[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  operations  Operation[]
  auditEvents AuditEvent[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set by the organization plugin so a session remembers which workspace is
  // active without a client-supplied header. Null before a user has any
  // workspace, or if the previously active one was deleted.
  activeOrganizationId String?

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Only set for the credential (email+password) provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Member {
  id        String     @id @default(cuid())
  role      MemberRole
  createdAt DateTime   @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// status is Better Auth's own internal state machine ("pending" | "accepted"
/// | "rejected" | "canceled", written directly by its route handlers) — kept
/// as a plain string rather than a Prisma enum so we never fight a value it
/// writes that we don't control.
model Invitation {
  id        String     @id @default(cuid())
  email     String
  role      MemberRole
  status    String     @default("pending")
  expiresAt DateTime
  createdAt DateTime   @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Brand {
  id                 String      @id @default(cuid())
  name               String
  websiteUrl         String
  domain             String
  description        String
  category           String
  // Structured first-party research captured during onboarding. These fields
  // ground competitor discovery and every generated AEO/GEO prompt in the
  // client's actual offers, audiences, problems, and editorial footprint.
  services           String[]    @default([])
  audiences          String[]    @default([])
  painPoints         String[]    @default([])
  contentThemes      String[]    @default([])
  differentiators    String[]    @default([])
  discoveryPageCount Int         @default(0)
  status             BrandStatus @default(ACTIVE)
  // IANA tz, e.g. "America/New_York" — distinct from Market.timezone, which
  // is where the audience is; this is where the team running the project is.
  timezone           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  defaultMarketId String?
  defaultMarket   Market? @relation(fields: [defaultMarketId], references: [id], onDelete: SetNull)

  competitors     Competitor[]
  prompts         Prompt[]
  batches         AnalysisBatch[]
  operations      Operation[]
  sites           Site[]
  topics          Topic[]
  goals           Goal[]
  projectKeywords ProjectKeyword[]
  voiceProfile    BrandVoiceProfile?
  crawlRuns       CrawlRun[]
  opportunities   Opportunity[]
  conquestPlans   ConquestPlan[]
  contentItems    ContentItem[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, updatedAt])
  @@index([defaultMarketId])
}

model Competitor {
  id          String           @id @default(cuid())
  name        String
  websiteUrl  String
  domain      String
  source      CompetitorSource @default(AI_DISCOVERED)
  status      CompetitorStatus @default(ACCEPTED)
  firstSeenAt DateTime         @default(now())
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  observations  CompetitorObservation[]
  threatScores  ThreatScore[]
  crawlRuns     CrawlRun[]
  opportunities Opportunity[]

  @@unique([brandId, domain])
  @@index([brandId])
  @@index([workspaceId])
}

// Reusable within a workspace — "US, English, Desktop" is one value object
// that several projects can share, referenced via Brand.defaultMarketId and
// Keyword.marketId. Not owned by a single Brand.
model Market {
  id        String       @id @default(cuid())
  country   String
  region    String?
  city      String?
  language  String
  device    MarketDevice @default(DESKTOP)
  // IANA tz — where the audience is, for scheduling and reporting windows.
  timezone  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  defaultForBrands Brand[]
  keywords         Keyword[]
  prompts          Prompt[]
  batches          AnalysisBatch[]
  serpSnapshots    SerpSnapshot[]

  @@unique([workspaceId, country, region, city, language, device])
  @@index([workspaceId])
}

// GSC properties, WordPress connections, and crawl targets (Phase 4+) attach
// to a Site, not a Brand directly — a project can eventually span more than
// one verified domain (e.g. a marketing site and a docs subdomain).
model Site {
  id                 String                  @id @default(cuid())
  domain             String
  verified           Boolean                 @default(false)
  verificationMethod SiteVerificationMethod?
  gscSiteUrl         String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  integrationConnections IntegrationConnection[]
  searchPerformanceRows  SearchPerformanceRow[]

  @@unique([brandId, domain])
  @@index([workspaceId])
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // vector(1536) — set via raw SQL only (Unsupported columns are excluded
  // from the generated Client entirely; see src/lib/embeddings/service.ts).
  // Null until src/lib/embeddings/service.ts has embedded this topic's name;
  // the Phase-5 opportunity detectors treat a topic with no embedding yet as
  // "not enough evidence to match pages," never as "matches nothing."
  embedding Unsupported("vector(1536)")?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  keywords      Keyword[]
  opportunities Opportunity[]
  contentItems  ContentItem[]

  @@unique([brandId, name])
  @@index([workspaceId])
}

// Scoped to a Market, not a Brand: the same keyword text has different
// volume/competition per market, but is the same underlying search term
// across every project that tracks it — Phase 3's SERP snapshot caching
// keys off (Keyword, Market), not per-project, so two projects targeting the
// same market never pay to fetch the same SERP twice. ProjectKeyword is the
// per-project join.
model Keyword {
  id         String         @id @default(cuid())
  text       String
  normalized String
  intent     KeywordIntent?
  createdAt  DateTime       @default(now())

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectKeywords        ProjectKeyword[]
  serpSnapshots          SerpSnapshot[]
  competitorObservations CompetitorObservation[]
  opportunities          Opportunity[]
  contentItems           ContentItem[]

  @@unique([marketId, normalized])
  @@index([workspaceId])
  @@index([topicId])
}

model ProjectKeyword {
  id        String                 @id @default(cuid())
  priority  ProjectKeywordPriority @default(MEDIUM)
  status    ProjectKeywordStatus   @default(ACTIVE)
  createdAt DateTime               @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([brandId, keywordId])
  @@index([workspaceId])
  @@index([keywordId])
}

model Goal {
  id          String   @id @default(cuid())
  type        GoalType
  targetValue Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([brandId])
}

// One per Brand. Only the free-text fields a human can review and approve
// exist today; approved writing samples (the actual generation input for
// Phase 6) are a distinct, larger surface deferred until content generation
// needs them.
model BrandVoiceProfile {
  id         String   @id @default(cuid())
  tone       String?
  audience   String?
  guidelines String?
  // Phase 6: human-approved writing samples fed into brief/draft prompts as
  // voice reference — an array of {text, approvedAt}. Deliberately separate
  // from tone/audience/guidelines above: those are a human's *description*
  // of the voice, this is *evidence* of it. Never populated by anything but
  // an explicit human approval action — see addApprovedVoiceSample() in
  // src/lib/brands/voice.ts.
  approvedSamples Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brandId String @unique
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// aliasSet is nullable and unpopulated by any UI in Phase 2 — a human-reviewed
// list of extra alias strings (abbreviations, misspellings) for this prompt's
// brand-matching, layered on top of Brand.name/Competitor.name in
// analyzeAnswer(). Reserved column now so it doesn't need its own migration
// later; see docs/benchmark-protocol.md.
model Prompt {
  id         String       @id @default(cuid())
  text       String
  type       PromptType
  source     PromptSource @default(AI_GENERATED)
  isActive   Boolean      @default(true)
  // Set the first time a human saves an edit or explicitly approves the
  // prompt — never on creation for AI_GENERATED prompts, always on creation
  // for USER_ADDED ones (a human typed it, so it is already reviewed).
  approvedAt DateTime?
  aliasSet   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // Prompts are phrased in the market's language, so every prompt belongs to
  // exactly one market — generation always runs against Brand.defaultMarketId.
  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runs PromptRun[]

  @@unique([brandId, text])
  @@index([brandId, isActive])
  @@index([workspaceId])
  @@index([marketId])
}

// See docs/benchmark-protocol.md for what each pinned field means and why a
// rerun must never overwrite a prior batch's rows.
model AnalysisBatch {
  id                String      @id @default(cuid())
  status            BatchStatus @default(PENDING)
  totalRuns         Int         @default(0)
  completedRuns     Int         @default(0)
  failedRuns        Int         @default(0)
  // How many samples per (prompt, provider, model) — PromptRun.repetitionIndex
  // ranges [0, repetitions).
  repetitions       Int         @default(1)
  // sha256 of the sorted (id, text) pairs of every prompt included in this
  // batch, computed at creation time — see computePromptSetHash() in
  // src/lib/benchmark/service.ts. A prompt edit changes this, which is the
  // point: it marks history before/after as non-comparable.
  promptSetHash     String
  extractionVersion String
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  operationId String    @unique
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  runs      PromptRun[]
  aggregate BenchmarkAggregate?

  @@index([brandId, createdAt])
  @@index([status])
  @@index([workspaceId])
  @@index([marketId])
}

model PromptRun {
  id                String    @id @default(cuid())
  provider          String
  model             String
  providerVersion   String?
  // Distinguishes repeated samples of the same (batch, prompt, provider,
  // model) — required for variance/confidence-interval reporting. See
  // docs/benchmark-protocol.md.
  repetitionIndex   Int       @default(0)
  locale            String?
  status            RunStatus @default(PENDING)
  providerRequestId String?
  responseText      String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  attemptCount      Int       @default(0)
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  batchId String
  batch   AnalysisBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  providerCallId String?
  providerCall   ProviderCall? @relation(fields: [providerCallId], references: [id], onDelete: SetNull)

  rawSnapshotId String?
  rawSnapshot   RawSnapshot? @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)

  analysis RunAnalysis?
  sources  Source[]

  @@unique([batchId, promptId, provider, model, repetitionIndex])
  @@index([batchId, status])
  @@index([promptId])
  @@index([workspaceId])
  @@index([providerCallId])
}

// Produced by the pure analyzeAnswer() extractor plus one sentiment judge
// call — see docs/benchmark-protocol.md for why extraction itself must stay
// deterministic. One row per PromptRun, never mutated after creation except
// by a reprocessing pass that bumps extractionVersion.
model RunAnalysis {
  id                    String    @id @default(cuid())
  brandMentioned        Boolean
  mentionCount          Int       @default(0)
  firstMentionCharIndex Int?
  position              Int?
  sentiment             Sentiment @default(NEUTRAL)
  // A refusal is its own bucket — neither a failure nor a non-mention. See
  // docs/benchmark-protocol.md.
  refused               Boolean   @default(false)
  confidence            Float     @default(1)
  extractionVersion     String
  competitorMentions    Json
  rawResult             Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  promptRunId String    @unique
  promptRun   PromptRun @relation(fields: [promptRunId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// One stored row per batch, not a view — a rerun creates a new observation
// set and a new aggregate; nothing is ever recomputed in place. See A2 in
// the implementation plan and docs/benchmark-protocol.md.
model BenchmarkAggregate {
  id            String   @id @default(cuid())
  visibility    Float?
  shareOfVoice  Float?
  avgPosition   Float?
  sentimentDist Json
  sampleSize    Int
  refusedCount  Int
  failedCount   Int
  computedAt    DateTime @default(now())

  batchId String        @unique
  batch   AnalysisBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// A global catalog, not tenant data — no workspaceId, never passed through
// scopedDb(). Unpopulated until Expansion C (multi-provider AI visibility)
// needs to surface version drift in reports; the column shape is reserved
// now so that phase doesn't need its own migration for it.
model ProviderModelVersion {
  id           String    @id @default(cuid())
  provider     String
  model        String
  version      String
  pinnedAt     DateTime  @default(now())
  deprecatedAt DateTime?

  @@unique([provider, model, version])
}

// One row per SERP fetch for a (keyword, market, device) — never overwritten;
// a rerun creates a new snapshot so rank history is real, not a mutated
// "latest" row. rawSnapshotId points at the raw provider JSON (immutable,
// content-addressed — see docs/adr/0005-storage-and-snapshots.md); this row
// is the parsed summary huntSerpFetch's cache-check reads before spending a
// Scrape.do credits on the same (keyword, market, device) again within TTL.
model SerpSnapshot {
  id          String       @id @default(cuid())
  device      MarketDevice
  fetchedAt   DateTime     @default(now())
  resultCount Int
  createdAt   DateTime     @default(now())

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  providerCallId String?
  providerCall   ProviderCall? @relation(fields: [providerCallId], references: [id], onDelete: SetNull)

  rawSnapshotId String?
  rawSnapshot   RawSnapshot? @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  results                SerpResult[]
  competitorObservations CompetitorObservation[]

  @@index([keywordId, marketId, device, fetchedAt])
  @@index([workspaceId])
}

model SerpResult {
  id                String         @id @default(cuid())
  position          Int
  url               String
  domain            String
  registrableDomain String
  title             String?
  snippet           String?
  type              SerpResultType @default(ORGANIC)
  createdAt         DateTime       @default(now())

  snapshotId String
  snapshot   SerpSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([registrableDomain])
  @@index([workspaceId])
}

// Evidence linking a competitor (or a not-yet-accepted candidate domain) to
// one SERP appearance — this is what the "why this competitor" panel reads,
// and what a future SERP-discovered competitor suggestion (Competitor.source
// = SERP_DISCOVERED) is built from. competitorId is nullable because an
// observation can exist for a domain before any human has accepted it as a
// tracked competitor.
model CompetitorObservation {
  id              String   @id @default(cuid())
  candidateDomain String
  position        Int
  createdAt       DateTime @default(now())

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  snapshotId String
  snapshot   SerpSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  keywordId String
  keyword   Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([snapshotId])
  @@index([keywordId])
  @@index([workspaceId])
}

// A global, versioned set of scoring weights — not tenant data, same
// treatment as ProviderModelVersion above. Recomputing under a new
// ScoreDefinition version never overwrites scores computed under the old
// one; both remain queryable so a score's meaning is always traceable to the
// exact weights that produced it. See src/lib/scoring/threat-v1.ts.
model ScoreDefinition {
  id        String   @id @default(cuid())
  name      String
  version   Int
  weights   Json
  createdAt DateTime @default(now())

  threatScores  ThreatScore[]
  opportunities Opportunity[]
  qualityScores QualityScore[]

  @@unique([name, version])
}

model ThreatScore {
  id            String   @id @default(cuid())
  value         Float
  components    Json
  confidence    Float
  evidenceCount Int
  computedAt    DateTime @default(now())

  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  scoreDefinitionId String
  scoreDefinition   ScoreDefinition @relation(fields: [scoreDefinitionId], references: [id], onDelete: Restrict)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([competitorId, computedAt])
  @@index([workspaceId])
}

// A user-authorized third-party account — Google Search Console today;
// future WordPress/Webflow/Shopify connections (Phase 7+) reuse this same
// shape and its capabilities matrix rather than introducing a second
// connection model.
model IntegrationConnection {
  id                String              @id @default(cuid())
  provider          IntegrationProvider
  externalAccountId String
  scopes            String[]
  status            IntegrationStatus   @default(PENDING)
  capabilities      Json
  lastValidatedAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  secret EncryptedSecret?

  @@unique([siteId, provider])
  @@index([workspaceId])
}

// The refresh token (or equivalent long-lived credential) for one
// IntegrationConnection, AES-256-GCM encrypted — see src/lib/crypto/envelope.ts.
// Application code must never select ciphertext/iv/authTag into a DTO; only
// the connection's own decrypt path reads them, and the decrypted value
// lives in memory only for the duration of one provider call. keyVersion
// supports rotating the encryption key without re-encrypting every row at
// once — see docs/adr/0003-provider-abstraction.md's sibling secrets note.
model EncryptedSecret {
  id         String    @id @default(cuid())
  ciphertext Bytes
  iv         Bytes
  authTag    Bytes
  keyVersion Int
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  connectionId String                @unique
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Reserved for Phase 7's CMS connectors (Expansion B) — nothing writes here
// yet. workspaceId is nullable because a webhook receiver only learns which
// workspace a delivery belongs to after inspecting the payload, and that
// resolution step doesn't exist until a connector needs it.
model WebhookDelivery {
  id           String                @id @default(cuid())
  provider     String
  eventType    String
  payload      Json
  status       WebhookDeliveryStatus @default(RECEIVED)
  receivedAt   DateTime              @default(now())
  processedAt  DateTime?
  errorMessage String?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([provider, eventType])
}

// Imported from Google Search Console's Search Analytics API — see
// src/lib/providers/gsc/import.ts. Upserted on the unique key below, so a
// re-import of an overlapping date range (gscDailyImport re-pulls a trailing
// window every run to catch GSC's own reporting delay) is idempotent rather
// than creating duplicate rows.
model SearchPerformanceRow {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  query       String
  page        String
  clicks      Int
  impressions Int
  ctr         Float
  position    Float
  createdAt   DateTime @default(now())

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([siteId, date, query, page])
  @@index([workspaceId])
  @@index([siteId, date])
}

// One crawl of one host. Anchored to whichever it's crawling — the client's
// own site (brandId) or one competitor's (competitorId), same "at least one
// of, enforced in application code" pattern as Source below. A recrawl is a
// new CrawlRun, never a resumed or overwritten one.
model CrawlRun {
  id             String         @id @default(cuid())
  host           String
  status         CrawlRunStatus @default(PENDING)
  totalPages     Int            @default(0)
  completedPages Int            @default(0)
  failedPages    Int            @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  operationId String     @unique
  operation   Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  snapshots PageSnapshot[]

  @@index([workspaceId, createdAt])
  @@index([brandId])
  @@index([competitorId])
}

// One row per crawled URL, immutable — a recrawl creates a new PageSnapshot
// rather than overwriting the last one, so content-change history and
// freshness signals are real. contentHash is a cheap "did this page change
// since last time" check without diffing full HTML.
model PageSnapshot {
  id           String     @id @default(cuid())
  url          String
  canonicalUrl String?
  contentHash  String
  httpStatus   Int
  renderMode   RenderMode @default(STATIC)
  fetchedAt    DateTime   @default(now())
  createdAt    DateTime   @default(now())

  crawlRunId String
  crawlRun   CrawlRun @relation(fields: [crawlRunId], references: [id], onDelete: Cascade)

  rawSnapshotId String?
  rawSnapshot   RawSnapshot? @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  observation PageObservation?
  schemas     SchemaObservation[]
  performance PerformanceObservation[]

  @@index([crawlRunId])
  @@index([url])
  @@index([workspaceId])
  @@index([contentHash])
}

// intent reuses KeywordIntent (informational/commercial/transactional/
// navigational) — it's the same concept applied to a crawled page instead
// of a tracked search term, and a page's classified intent is exactly what
// gets compared against a keyword's intent for the Phase 5 gap detectors.
model PageObservation {
  id                  String         @id @default(cuid())
  title               String?
  description         String?
  headings            Json
  wordCount           Int
  internalLinks       Int
  externalLinks       Int
  mediaCounts         Json
  publishedAt         DateTime?
  modifiedAt          DateTime?
  freshnessConfidence Float
  intent              KeywordIntent?
  createdAt           DateTime       @default(now())

  // vector(1536) of title+description — same raw-SQL-only treatment as
  // Topic.embedding above. Powers the Phase-5 topic-to-page similarity match
  // (src/lib/embeddings/service.ts#findTopicCoverage) that the opportunity
  // detectors compare against.
  embedding Unsupported("vector(1536)")?

  snapshotId String       @unique
  snapshot   PageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model SchemaObservation {
  id         String   @id @default(cuid())
  type       String
  valid      Boolean
  mismatches Json
  createdAt  DateTime @default(now())

  snapshotId String
  snapshot   PageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([workspaceId])
}

// FIELD (CrUX real-user data) and LAB (synthetic, e.g. PSI) are stored and
// labelled separately, never blended into one number — see the plan's own
// correction on this. Only FIELD is populated so far; LAB is a reserved
// source value until a synthetic testing path exists.
model PerformanceObservation {
  id          String            @id @default(cuid())
  lcp         Float?
  inp         Float?
  cls         Float?
  source      PerformanceSource
  collectedAt DateTime          @default(now())

  snapshotId String
  snapshot   PageSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([workspaceId])
}

// Global (no workspaceId), queried through the plain db client, never
// scopedDb() — same treatment as ScoreDefinition/ProviderModelVersion.
// robots.txt for a host is a fact about that host, not about which
// workspace is asking; caching it once per host instead of once per
// (host, workspace) is both correct and the whole point of a cache.
model RobotsCache {
  id        String   @id @default(cuid())
  host      String   @unique
  body      String
  fetchedAt DateTime @default(now())
  expiresAt DateTime
}

// Also global, same reasoning as RobotsCache — whether example.com blocks
// GPTBot is a fact about example.com. See src/lib/geo/ai-crawler-audit.ts.
model AiCrawlerAccess {
  id        String   @id @default(cuid())
  domain    String
  botName   String
  allowed   Boolean
  checkedAt DateTime @default(now())
  evidence  String

  @@unique([domain, botName])
}

// One row per detected gap. `score`/`confidence`/`components` follow the
// same masked-weighted-sum shape as ThreatScore (src/lib/scoring/weighted.ts)
// under their own ScoreDefinition ("opportunity-v1"), not the strategy
// document's multiplicative formula — see A1 #2 in the implementation plan.
// `title`/`summary`/`recommendedActions` are deterministic, generated by the
// detector itself (src/lib/opportunity/detectors/*.ts) so the feature works
// with no LLM configured; src/lib/opportunity/explain.ts best-effort
// upgrades summary/recommendedActions to more natural language afterward.
//
// topicId/keywordId are null for CITATION_GAP, which is brand-wide evidence
// (AI-benchmark citation share) rather than a single crawled page's gap
// against one topic. competitorId is null only when a kind has no single
// competitor to point at (not used by any detector yet, but the column
// isn't forced non-null for kinds that might need it later).
//
// dedupeKey + the unique constraint below is what stops a dismissed
// opportunity from being recreated the next time detection runs — see
// src/lib/opportunity/dedupe.ts. A rerun that produces the same dedupeKey
// is silently skipped, never upserted; recomputing a *fresher* score for an
// existing gap is a deliberate non-goal of this version (see the comment on
// createOpportunityIfNew in src/lib/opportunity/service.ts).
model Opportunity {
  id                 String            @id @default(cuid())
  kind               OpportunityKind
  status             OpportunityStatus @default(NEW)
  score              Float
  confidence         Float
  components         Json
  dedupeKey          String
  title              String
  summary            String
  recommendedActions Json
  detectedAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  keywordId String?
  keyword   Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  scoreDefinitionId String
  scoreDefinition   ScoreDefinition @relation(fields: [scoreDefinitionId], references: [id], onDelete: Restrict)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  evidence     OpportunityEvidence[]
  decisions    OpportunityDecision[]
  planItems    PlanItem[]
  contentItems ContentItem[]

  @@unique([brandId, dedupeKey])
  @@index([brandId, status, score])
  @@index([workspaceId])
}

// What backs one Opportunity's detection — a specific PageSnapshot,
// CompetitorObservation, RunAnalysis, or Keyword row. sourceTable/sourceId
// are a loose reference (not a Prisma relation) since the source model
// varies by evidence kind — mirrors ProviderCall's own posture toward
// heterogeneous references elsewhere in the schema.
model OpportunityEvidence {
  id          String                  @id @default(cuid())
  kind        OpportunityEvidenceKind
  sourceTable String
  sourceId    String
  url         String?
  note        String?
  createdAt   DateTime                @default(now())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([workspaceId])
}

// A human decision on an Opportunity — append-only history, not a mutation
// of a single "current decision" row, so a reversed call (e.g. DISMISSED
// then later re-ACCEPTED) stays auditable. Opportunity.status always mirrors
// the most recent row here; see recordOpportunityDecision() in
// src/lib/opportunity/service.ts, the only writer of both.
model OpportunityDecision {
  id        String            @id @default(cuid())
  status    OpportunityStatus
  reason    String?
  actorId   String?
  decidedAt DateTime          @default(now())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([workspaceId])
}

// One per brand per ISO week (weekStart = that week's Monday, UTC midnight).
// A thin container — PlanItem is what actually links to an Opportunity. See
// A "1-3 recommended actions, not a forced Mon/Wed/Fri publishing quota" in
// the implementation plan: this table holds what a human chose to work on
// this week, not a system-generated schedule.
model ConquestPlan {
  id        String   @id @default(cuid())
  weekStart DateTime
  createdAt DateTime @default(now())

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  items PlanItem[]

  @@unique([brandId, weekStart])
  @@index([workspaceId])
}

model PlanItem {
  id        String    @id @default(cuid())
  ownerId   String?
  dueAt     DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  planId String
  plan   ConquestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([planId, opportunityId])
  @@index([workspaceId])
}

// The top-level content record — one per piece of content being built,
// optionally addressing an Opportunity. Its own history (research, drafts,
// approvals) lives in the child tables below; ContentItem itself only holds
// current identity and state. "Latest" research packet or version is always
// found by querying, never by a forward pointer — same convention as
// getLatestCrawlRun/getLatestAggregate elsewhere, which avoids the circular
// FK a "currentVersionId" column would require.
model ContentItem {
  id              String       @id @default(cuid())
  title           String
  slug            String?
  state           ContentState @default(PLANNED)
  targetWordCount Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  keywordId String?
  keyword   Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  researchPackets ResearchPacket[]
  versions        ContentVersion[]

  @@index([brandId, state])
  @@index([opportunityId])
  @@index([workspaceId])
}

// The brief IS the research packet — audience/intent/angle/outline/coverage
// goals/evidence/first-party-inputs-needed/internal-link-candidates/
// visual-suggestions/schema-recommendation all live here, matching the
// implementation plan's model list exactly (it lists ResearchPacket, not a
// separate Brief table). Append-only like SerpSnapshot/ThreatScore — a
// re-run creates a new packet rather than overwriting; the latest one by
// createdAt is what BRIEF_READY and drafting read.
model ResearchPacket {
  id                     String   @id @default(cuid())
  audience               String?
  intent                 String?
  angle                  String?
  outline                Json
  evidence               Json
  firstPartyInputsNeeded Json
  internalLinkCandidates Json
  visualSuggestions      Json
  schemaRecommendation   String?
  createdAt              DateTime @default(now())

  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt])
  @@index([workspaceId])
}

// Immutable once an Approval with decision=APPROVED exists for it — any
// further edit creates a new ContentVersion (parentVersionId pointing back)
// rather than mutating this row. See updateDraftContent() and
// createRevisionVersion() in src/lib/content/service.ts, the only two
// writers of `doc`/`html`, and the acceptance test this exists to satisfy:
// "Approved versions are immutable; edits create a new version and
// invalidate approval."
model ContentVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  // ProseMirror JSON — the editor's native format, TipTap's source of truth.
  doc           Json
  // Rendered HTML, denormalized for fast display and SEO checks — see
  // src/lib/content/prosemirror.ts's renderToHtml(), the only writer.
  html          String
  wordCount     Int
  createdBy     String?
  createdAt     DateTime @default(now())

  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  parentVersionId String?
  parentVersion   ContentVersion?  @relation("ContentVersionHistory", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   ContentVersion[] @relation("ContentVersionHistory")

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  claims        Claim[]
  approvals     Approval[]
  qualityScores QualityScore[]

  @@unique([contentItemId, versionNumber])
  @@index([workspaceId])
}

// One row per claim the draft makes — extracted by an LLM call
// (src/lib/content/claims.ts) but gated by pure, deterministic blocker
// logic (src/lib/content/blockers.ts), per A5's "LLM proposes, pure
// functions decide" split. FACTUAL claims with no RESOLVED status (i.e. no
// EvidenceLink) block approval; OPINION/FIRST_PARTY do not, since they were
// never claims that needed a source in the first place.
model Claim {
  id           String        @id @default(cuid())
  text         String
  kind         ClaimKind
  status       ClaimStatus   @default(UNRESOLVED)
  riskCategory RiskCategory?
  createdAt    DateTime      @default(now())

  contentVersionId String
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  evidenceLinks EvidenceLink[]

  @@index([contentVersionId])
  @@index([workspaceId])
}

// What resolves a Claim — a URL (research-packet evidence, a competitor
// page, a first-party input) or a loose sourceTable/sourceId reference into
// evidence already collected elsewhere (OpportunityEvidence, PageSnapshot,
// Source), same loose-reference shape as OpportunityEvidence for the same
// reason: the source model varies by evidence kind.
model EvidenceLink {
  id          String   @id @default(cuid())
  url         String?
  note        String?
  sourceTable String?
  sourceId    String?
  createdAt   DateTime @default(now())

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([workspaceId])
}

// A human decision on one ContentVersion — append-only, same posture as
// OpportunityDecision. The most recent APPROVED row for a version is what
// makes it immutable; a later CHANGES_REQUESTED row on a *different*
// (newer) version does not reopen an already-approved one.
model Approval {
  id        String           @id @default(cuid())
  decision  ApprovalDecision
  comment   String?
  actorId   String?
  decidedAt DateTime         @default(now())

  contentVersionId String
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contentVersionId])
  @@index([workspaceId])
}

// LLM-as-judge output against a fixed rubric (src/lib/quality/judge.ts),
// scored with the same masked-weighted-sum shape as ThreatScore/Opportunity
// (src/lib/scoring/weighted.ts) under its own ScoreDefinition
// ("quality-v1"). judgeVersion is separate from scoreDefinitionId: the
// latter versions the component *weights*, the former versions the judge
// *prompt/rubric* — a prompt change should not silently reinterpret old
// scores as having used new weights, or vice versa. Advisory only — see
// src/lib/content/blockers.ts for what actually gates approval; a low
// QualityScore never blocks by itself.
model QualityScore {
  id           String   @id @default(cuid())
  value        Float
  confidence   Float
  components   Json
  judgeVersion String
  computedAt   DateTime @default(now())

  contentVersionId String
  contentVersion   ContentVersion @relation(fields: [contentVersionId], references: [id], onDelete: Cascade)

  scoreDefinitionId String
  scoreDefinition   ScoreDefinition @relation(fields: [scoreDefinitionId], references: [id], onDelete: Restrict)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contentVersionId])
  @@index([workspaceId])
}

// Anchored to whichever produced it: a PromptRun (Phase 2 benchmark runs) or
// directly a ProviderCall (every other generation call, starting with brand
// discovery in Phase 1a, which has no PromptRun to attach to). Application
// code must set at least one — Prisma has no schema-level "at least one of"
// constraint for this.
model Source {
  id            String   @id @default(cuid())
  url           String
  domain        String
  title         String?
  snippet       String?
  providerRef   String?
  citationIndex Int?
  isCitation    Boolean  @default(false)
  createdAt     DateTime @default(now())

  promptRunId String?
  promptRun   PromptRun? @relation(fields: [promptRunId], references: [id], onDelete: Cascade)

  providerCallId String?
  providerCall   ProviderCall? @relation(fields: [providerCallId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([promptRunId, url])
  @@index([domain])
  @@index([promptRunId])
  @@index([providerCallId])
  @@index([workspaceId])
}

// The user-facing unit of long-running work. Route handlers create one and
// return 202 with its id; Inngest functions advance it. See
// docs/adr/0006-workflows-and-operations.md.
model Operation {
  id              String          @id @default(cuid())
  kind            OperationKind
  status          OperationStatus @default(PENDING)
  progressCurrent Int             @default(0)
  progressTotal   Int             @default(0)
  idempotencyKey  String          @unique
  inngestRunId    String?
  errorCode       String?
  errorMessage    String?
  metadata        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Nullable: a create-brand operation has no brand until discovery persists
  // one. Set once the row exists.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  // SetNull, not Cascade: an Operation is a historical record and must
  // survive the actor's account being deleted later (Phase 8).
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  providerCalls ProviderCall[]
  usageEvents   UsageEvent[]
  batch         AnalysisBatch?
  crawlRun      CrawlRun?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([brandId])
}

// Every external provider request, regardless of phase. Written exclusively
// by src/lib/providers/instrument.ts — adapters never write this table
// themselves. See docs/adr/0003-provider-abstraction.md.
model ProviderCall {
  id              String             @id @default(cuid())
  capability      ProviderCapability
  provider        String
  providerVersion String?
  requestId       String?
  status          RunStatus          @default(PENDING)
  requestedAt     DateTime
  completedAt     DateTime?
  httpStatus      Int?
  costUnits       Decimal?           @db.Decimal(12, 6)
  currency        String?
  inputTokens     Int?
  outputTokens    Int?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime           @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  rawSnapshotId String?
  rawSnapshot   RawSnapshot? @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull)

  promptRuns    PromptRun[]
  sources       Source[]
  serpSnapshots SerpSnapshot[]

  @@index([workspaceId, provider, createdAt])
  @@index([operationId])
}

// Content-addressed, immutable. Small payloads (<256KB) live in
// RawSnapshotBlob; larger ones (from Phase 4 onward) live in R2 and this row
// only carries the pointer. See docs/adr/0005-storage-and-snapshots.md.
model RawSnapshot {
  id             String         @id @default(cuid())
  driver         StorageDriver
  objectKey      String
  sha256         String
  mimeType       String
  byteSize       Int
  retentionClass RetentionClass @default(STANDARD)
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  blob          RawSnapshotBlob?
  providerCalls ProviderCall[]
  promptRuns    PromptRun[]
  serpSnapshots SerpSnapshot[]
  pageSnapshots PageSnapshot[]

  @@unique([workspaceId, sha256])
  @@index([workspaceId, createdAt])
}

model RawSnapshotBlob {
  id        String   @id @default(cuid())
  bytes     Bytes
  createdAt DateTime @default(now())

  snapshotId String      @unique
  snapshot   RawSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

// The source of truth for entitlement enforcement. Stripe (Phase 8) posts
// meter events for invoicing only — it never gates access.
model UsageEvent {
  id             String   @id @default(cuid())
  meter          String
  quantity       Decimal  @db.Decimal(14, 4)
  idempotencyKey String   @unique
  occurredAt     DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  operationId String?
  operation   Operation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, meter, occurredAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  // SetNull, not Cascade: an audit trail must outlive the actor's account.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

// Optional per-workspace override. Absence of a row means "use the code
// defaults in src/lib/usage/entitlements.ts" — most workspaces never need one.
model Entitlement {
  id        String   @id @default(cuid())
  plan      String   @default("beta")
  limits    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Absence of a row means "use the code default in src/lib/flags.ts". There is
// no global-only row by design — see docs/adr/0007.
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  enabled   Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// A fixed-window token bucket. One row per (route-class, subject) pair; see
// src/lib/api/rate-limit.ts.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}
